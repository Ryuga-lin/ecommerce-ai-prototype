# 复制本文件为 .env.local，然后填入你在 DeepSeek 服务台创建的 API Key
# 注意：.env.local 已被 .gitignore 忽略，不会提交到 Git

DEEPSEEK_API_KEY=sk-你的密钥粘贴在这里

# 当前推荐模型 ID。教程中的 deepseek-v4-flash 为旧名称，仍可用。
# 模型会持续更新，请以官方文档 https://api-docs.deepseek.com/quick_start/pricing 为准
DEEPSEEK_MODEL=deepseek-flash

# 可选：本地端口，默认 3000
PORT=3000
